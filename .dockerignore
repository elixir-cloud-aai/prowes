# Only send the files needed by the image build to the build context: files
# of the build context that the `Dockerfile` copies land in a layer of the
# image (`tests/test_build_context.py` checks this file)
*
!pro_wes/
!LICENSE
!README.md
!pyproject.toml
!requirements.txt
!setup.py

# Exclude caches and local files within the included paths
**/__pycache__
**/*.py[cod]
**/*.egg-info

# Exclude secrets also within the included paths (e.g., `pro_wes/.env`);
# secrets come in only at runtime (environment variables, mounted secrets)
**/.[Ee][Nn][Vv]*
!**/.env.example
**/.env.example/**
**/*.[Pp][Ee][Mm]
**/*.[Kk][Ee][Yy]
**/*.[Pp]12
**/*.[Pp][Ff][Xx]
